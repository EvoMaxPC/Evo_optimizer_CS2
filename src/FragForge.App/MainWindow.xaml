<Window x:Class="FragForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="860" Width="1320" MinHeight="680" MinWidth="1000"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" WindowStartupLocation="CenterScreen">
  <!-- Capa 11.3: pestañas por capa, conectadas a los comandos y colecciones que ya existen en el
       ViewModel. No hay lógica nueva aquí: cada botón llama a un comando de FragForge.UI.Core. -->
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Barra superior: perfil, idioma, acciones ===== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10" KeyboardNavigation.TabNavigation="Cycle">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="{Binding Localizer[profile.label]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Width="170" ItemsSource="{Binding Profiles}" DisplayMemberPath="Label"
                  SelectedValuePath="Profile" SelectedValue="{Binding SelectedProfile}"
                  ToolTip="{Binding TweakCountText}"
                  AutomationProperties.Name="{Binding Localizer[a11y.profile]}"/>
        <TextBlock Text="{Binding TweakCountText}" VerticalAlignment="Center" Margin="4,0,14,0"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        <TextBlock Text="{Binding Localizer[culture.label]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Width="90" ItemsSource="{Binding Cultures}" SelectedItem="{Binding Culture}"
                  AutomationProperties.Name="{Binding Localizer[a11y.culture]}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Medición" Click="OpenMeasurementTab_Click"/>
        <Button Content="{Binding Localizer[nav.scan]}" Command="{Binding ScanCommand}"/>
        <Button Content="{Binding Localizer[preview.button]}" Command="{Binding PreviewCommand}"/>
        <Button Content="{Binding Localizer[nav.apply]}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="{Binding Localizer[nav.revert]}" Command="{Binding RevertCommand}" Style="{StaticResource DangerButton}"/>
        <Button Content="{Binding Localizer[cancel]}" Command="{Binding CancelCommand}"/>
        <ToggleButton Content="{Binding SessionStateText}" Command="{Binding ToggleSessionCommand}"
                      ToolTip="{Binding Localizer[session.tooltip]}" Margin="6,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- ===== Hardware ===== -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="{Binding Localizer[hardware.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding HardwareSummary}" TextWrapping="Wrap" FontSize="12">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HardwareItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
          <ItemsControl ItemsSource="{Binding HardwareItems}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLabels"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- ===== Pestañas ===== -->
    <TabControl x:Name="MainTabs" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                AutomationProperties.Name="FragForge" KeyboardNavigation.TabNavigation="Local">

      <TabItem Header="{Binding Localizer[tab.summary]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Localizer[summary.hint]}" TextWrapping="Wrap" Margin="0,0,0,8">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HardwareSummary}" Value="Ejecuta Escanear para detectar el equipo."><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Localizer[apply.flow]}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Localizer[security.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding SecuritySummary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding SecurityContract}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
            <Button Content="{Binding Localizer[security.refresh]}" Command="{Binding ReadSecurityCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.tweaks]}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DataGrid Grid.Column="0" ItemsSource="{Binding Tweaks}" AutoGenerateColumns="False" CanUserAddRows="False"
                    IsReadOnly="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                    RowBackground="{StaticResource PanelBrush}" AlternatingRowBackground="{StaticResource Bg2Brush}" ColumnHeaderHeight="30" RowHeaderWidth="0"
                    AutomationProperties.Name="{Binding Localizer[a11y.tweaks]}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Tweak" Binding="{Binding Title}" Width="230" IsReadOnly="True"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Categoría" Binding="{Binding Category}" Width="80" IsReadOnly="True"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Binding="{Binding Evidence}" Width="85" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localizer[evidence.column], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Binding="{Binding Risk}" Width="85" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localizer[risk.column], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Binding="{Binding RebootDisplay}" Width="70" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localizer[reboot.required], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Estado" Binding="{Binding StateDisplay}" Width="120" IsReadOnly="True"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Anticheat" Binding="{Binding AnticheatNote}" Width="170" IsReadOnly="True"/>
              <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Motivo" Binding="{Binding Reason}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Column="0" Text="No hay tweaks para mostrar." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tweaks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsRestorePointAck}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <StackPanel>
                    <TextBlock Text="La protección del sistema está desactivada. Podés aplicar igual, pero Windows no va a poder volver solo al estado anterior. La vuelta atrás es el revert de FragForge." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                    <CheckBox IsChecked="{Binding RestorePointAckChecked}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8">
                      <TextBlock Text="Entiendo que no hay punto de restauración del sistema y que la única vuelta atrás es el revert de FragForge." TextWrapping="Wrap"/>
                    </CheckBox>
                    <Button Content="Aplicar de todos modos" Command="{Binding ApplyWithoutRestoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding Localizer[preview.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <ListBox ItemsSource="{Binding PlannedChanges}" MaxHeight="240" Background="{StaticResource Bg0Brush}" BorderBrush="{StaticResource BorderBrush}"
                         AutomationProperties.Name="{Binding Localizer[preview.title]}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding Localizer[preview.note]}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8"/>
                <TextBlock Text="{Binding Localizer[reboot.required]}" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.diagnostics]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Localizer[doctor.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Sin diagnósticos todavía. Ejecuta Doctor para consultar." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Checks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Doctor" Command="{Binding DoctorCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.cs2]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Localizer[cs2Path]}" Margin="0,0,0,4"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseCs2Command}" Margin="6,0,0,0"/>
              <TextBox Text="{Binding Cs2Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localizer[cs2Path]}"/>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.session]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Localizer[session.tooltip]}" TextWrapping="Wrap"/>
            <ToggleButton Content="{Binding SessionStateText}" Command="{Binding ToggleSessionCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.network]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="fragforge net diagnose | fragforge net probe --host H --count N"
                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.security]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Localizer[security.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding SecuritySummary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding SecurityContract}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
            <Button Content="{Binding Localizer[security.refresh]}" Command="{Binding ReadSecurityCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="MeasurementTab" Header="Medición">
        <Grid Margin="8" DataContext="{Binding Measurement, RelativeSource={RelativeSource AncestorType=Window}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Duración en segundos (vacío: partida completa):" VerticalAlignment="Center"/>
              <TextBox Width="100" Margin="8,0" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"/>
              <CheckBox Content="{Binding SaveLogText}" IsChecked="{Binding SaveLog}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="12,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Iniciar" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/>
              <Button Content="Ver ahora" Command="{Binding ShowNowCommand}"/>
              <Button Content="Marcar segmento" Command="{Binding ToggleSegmentCommand}"/>
              <Button Content="Terminar" Command="{Binding FinishCommand}" Style="{StaticResource DangerButton}"/>
              <Button Content="Cerrar pestaña" Click="CloseMeasurementTab_Click"/>
            </StackPanel>
          </StackPanel>
          <TextBox Grid.Row="2" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                   FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" AutomationProperties.Name="Informe de medición"/>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding Localizer[tab.maintenance]}">
        <Grid Margin="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Localizer[ops.title]}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding Localizer[ops.note]}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,6"/>
            <TextBlock Text="No hay operaciones para mostrar." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Operations.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding Operations}" MaxHeight="260" Background="{StaticResource Bg0Brush}" BorderBrush="{StaticResource BorderBrush}"
                     AutomationProperties.Name="{Binding Localizer[ops.title]}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Width="200" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CreatedAt}" Width="170"/>
                    <Button Content="Revertir"
                            Command="{Binding DataContext.RevertOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="{Binding Localizer[ops.button]}" Command="{Binding RefreshOperationsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <Button Content="{Binding Localizer[nav.snapshot]}" Command="{Binding SnapshotCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <Button Content="{Binding Localizer[nav.export]}" Command="{Binding ExportCommand}" HorizontalAlignment="Left"/>
            <CheckBox Content="{Binding Localizer[restorePoint]}" IsChecked="{Binding CreateRestorePoint}" Margin="0,12,0,4"/>
            <CheckBox Content="{Binding Localizer[enableProtection]}" IsChecked="{Binding EnableSystemProtection}" Margin="0,0,0,4"/>
            <Border BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Opciones de riesgo" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Advertencia: revisa estas opciones antes de aplicarlas." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,8"/>
                <CheckBox Content="{Binding Localizer[force]}" IsChecked="{Binding Force}" Margin="0,0,0,4"/>
                <CheckBox Content="{Binding Localizer[allowPowerShell]}" IsChecked="{Binding AllowPowerShell}"/>
                <TextBlock Text="{Binding Localizer[risk.phrase]}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding RiskPhrase, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localizer[risk.phrase]}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- ===== Estado y registro ===== -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="80"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,4">
        <ProgressBar Width="220" Height="10" Minimum="0" Maximum="100" DockPanel.Dock="Right" VerticalAlignment="Center">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Value" Value="{Binding ProgressValue}"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="False"><Setter Property="Value" Value="0"/></DataTrigger></Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextPrimaryBrush}"
               BorderBrush="{StaticResource BorderBrush}" FontFamily="Consolas" FontSize="11"
               AutomationProperties.Name="{Binding Localizer[logs.title]}"/>
    </Grid>
  </Grid>
</Window>

<Application x:Class="FragForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#171E26"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2D3947"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4FB3FF"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243140"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#3B4C60"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1218"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#3B4C60"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#243140"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <!-- Encabezado de la tabla de tweaks. Sin este estilo, WPF usa el chrome CLARO por defecto mientras
         el texto hereda el Foreground claro de la ventana: encabezado casi ilegible (hotfix Capa 0). -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1B2733"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#2D3947"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <!-- Mismo problema en las filas/celdas: el fondo del DataGrid es oscuro pero la celda por defecto
         no lo hereda en todos los temas, así que se fija explícitamente. -->
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#2D3947"/>
      <Setter Property="Padding" Value="6,4"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1F5F8B"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>

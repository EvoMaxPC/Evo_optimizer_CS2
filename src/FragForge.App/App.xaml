<Application x:Class="FragForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#171E26"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2D3947"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4FB3FF"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243140"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#3B4C60"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1218"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#3B4C60"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <!-- Ronda 4: el combo se veia "vacio" (filas en blanco, caja gris claro) aunque el binding era
         correcto. El cromo es el de la plantilla Aero2, que es CLARO e IGNORA Background: por eso el
         #243140 nunca se vio. Con Foreground claro heredado, el texto quedaba claro sobre claro.
         Con la plantilla por defecto el texto solo se ve bien OSCURO. Se cambia el Foreground, no el
         fondo: la caja se seguira viendo gris claro (es el cromo del tema, no nuestro Background). -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#243140"/>
      <Setter Property="Foreground" Value="#101820"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <!-- El desplegable NO hereda los setters del ComboBox: ComboBoxItem es un contenedor aparte y sin
         estilo propio toma el Foreground del tema, no el de la caja. Se fija explicitamente.
         No se toca Background: el resaltado de la fila seleccionada lo pinta el tema. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#101820"/>
    </Style>
    <!-- Encabezado de la tabla de tweaks. Sin este estilo, WPF usa el chrome CLARO por defecto mientras
         el texto hereda el Foreground claro de la ventana: encabezado casi ilegible (hotfix Capa 0). -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1B2733"/>
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#2D3947"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <!-- Mismo problema en las filas/celdas: el fondo del DataGrid es oscuro pero la celda por defecto
         no lo hereda en todos los temas, así que se fija explícitamente. -->
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#E8EDF2"/>
      <Setter Property="BorderBrush" Value="#2D3947"/>
      <Setter Property="Padding" Value="6,4"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1F5F8B"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
